<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Le parent fournit le BOM Spring Boot : toutes les versions des
         dependances ci-dessous en decoulent. Aucune n'est fixee a la main. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>io.github.alioukara</groupId>
    <artifactId>secure-file-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>secure-file-service</name>
    <description>File service with mandatory antivirus scan before delivery</description>

    <properties>
        <!-- Java 21 : LTS, et threads virtuels pour les appels bloquants. -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <!-- API REST, Tomcat embarque, StreamingResponseBody. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistance. La table porte l'etat des fichiers : c'est elle la
             source de verite, et elle sert aussi de file de scan. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validation des DTO entrants, dans les controllers uniquement. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Schema versionne. Changelogs YAML declaratifs, traduits vers le
             dialecte cible : le meme changelog tourne sur MySQL et sur H2.
             Indispensable a ddl-auto=validate, qui n'a rien a valider sans un
             schema cree en amont. -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>

        <!-- Pilote MySQL. Scope runtime : aucun code ne le reference, il n'a
             pas a etre sur le classpath de compilation. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Base en memoire pour les tests. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Apporte JUnit 5, Mockito et AssertJ : les conventions de test du
             projet sont couvertes sans dependance supplementaire. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Produit le jar executable et gere le lancement en
                 developpement. Version heritee du parent. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
